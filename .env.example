# ============================================================================
# Overseas Social MCP — environment configuration
# Configure only the platforms you actually use; others degrade gracefully.
# Set these in the MCP client's env block, or put them in
# ~/.config/overseas-social-mcp/.env (override the path with OSMCP_ENV_FILE);
# the server loads that file at startup and client-set values win.
# ============================================================================

# ---- global guardrails ------------------------------------------------------
OSMCP_DEFAULT_MAX=20
OSMCP_MAX_HARD_LIMIT=100
OSMCP_DELAY_MIN=1
OSMCP_DELAY_MAX=3
OSMCP_RATE_CALLS=20
OSMCP_RATE_WINDOW=600
OSMCP_TIMEOUT=60

# ---- X / Twitter (twscrape, unofficial) -------------------------------------
# Install:  pip install --user twscrape
# Add an account via the twscrape CLI, using this same path:
#   twscrape --db ~/.config/overseas-social-mcp/x_accounts.db add_cookie my_account
OSMCP_X_ENABLED=true
OSMCP_X_ACCOUNTS_DB=~/.config/overseas-social-mcp/x_accounts.db

# ---- Reddit (PRAW, OFFICIAL API — recommended) ------------------------------
# Create a 'script' app at https://www.reddit.com/prefs/apps
OSMCP_REDDIT_CLIENT_ID=
OSMCP_REDDIT_CLIENT_SECRET=
OSMCP_REDDIT_USER_AGENT=overseas-social-mcp/0.1 by research

# ---- Telegram (Telethon, OFFICIAL MTProto — recommended) --------------------
# Get api_id / api_hash from https://my.telegram.org, then run
#   python3 -m overseas_social_mcp.telegram_login
# which fills these in for you (in ~/.config/overseas-social-mcp/.env).
OSMCP_TG_API_ID=
OSMCP_TG_API_HASH=
OSMCP_TG_SESSION=~/.config/overseas-social-mcp/telegram.session

# ---- LinkedIn (linkedin_scraper, HIGH RISK — off by default) ----------------
# Enabling scraping violates LinkedIn ToS and may restrict your account.
OSMCP_LINKEDIN_ENABLED=false
OSMCP_LINKEDIN_EMAIL=
OSMCP_LINKEDIN_PASSWORD=
OSMCP_CHROMEDRIVER=/absolute/path/to/chromedriver
